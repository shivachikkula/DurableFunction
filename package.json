{
  "name": "durable-function-patterns",
  "version": "1.0.0",
  "description": "Azure Durable Functions app demonstrating the five primary orchestration patterns",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "durable-functions": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  }
}
